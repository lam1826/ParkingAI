# This file is copied manually to STATE_DIR/.env.production on the server.
# Never commit the real file.
COMPOSE_PROJECT_NAME=parkingai-production
API_DOMAIN=api.example.com
TLS_EMAIL=ops@example.com

# Managed PostgreSQL only. Require TLS according to your provider.
DATABASE_URL=postgresql+psycopg://parkingai:change-me@db.example.com:5432/parkingai?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=replace-with-at-least-32-random-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://parking.example.com
MANAGER_REGISTRATION_CODE=replace-with-a-private-manager-code
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-code

# AI remains fail-closed until an operator explicitly enables it.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
