SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# API key cua AI provider (Google Gemini). De trong -> cac endpoint sinh noi
# dung AI tra 503; endpoint doc lich su va thong ke van hoat dong binh thuong.
# Fail closed: ke ca co key, provider chi duoc goi khi moi truong bat ro rang.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER_TIMEOUT_MS=85000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MANAGER_REGISTRATION_CODE=replace-with-a-private-manager-code
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-code
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600
READINESS_CACHE_SECONDS=5
# /docs, /redoc va /openapi.json: tat mac dinh; chi bat tren may phat trien.
API_DOCS_ENABLED=false
# Gioi han body doc truoc routing: JSON/form/multipart 1 MiB, gui xong trong 30 giay
# (vuot -> 413, qua thoi gian -> 408, client ngat giua chung -> 400). Rieng 3 route anh
# camera (/api/v2/vision/observations|live-frames|edge-events) tu doc anh sau khi xac thuc
# (toi da 2 MB, 30 giay); MAX_UPLOAD_BODY_BYTES chi chan som Content-Length khai bao lon hon.
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=8388608
# DATABASE_URL la bien moi truong HE DIEU HANH (khong doc tu file .env).
# Mac dinh he thong dung SQLite tai backend/database/parking.db.
# DATABASE_URL=sqlite:///./parking.db
