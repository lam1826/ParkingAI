SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# API key cua AI provider (Google Gemini). De trong -> cac endpoint /ai/* tra 503,
# cac chuc nang thong ke van hoat dong binh thuong.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MANAGER_REGISTRATION_CODE=replace-with-a-private-manager-code
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-code
# DATABASE_URL la bien moi truong HE DIEU HANH (khong doc tu file .env).
# Mac dinh he thong dung SQLite tai backend/database/parking.db.
# DATABASE_URL=sqlite:///./parking.db
