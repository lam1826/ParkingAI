SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# API key cua AI provider (Google Gemini). De trong -> cac endpoint sinh noi
# dung AI tra 503; endpoint doc lich su va thong ke van hoat dong binh thuong.
# Fail closed: ke ca co key, provider chi duoc goi khi moi truong bat ro rang.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER_TIMEOUT_MS=85000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MANAGER_REGISTRATION_CODE=replace-with-a-private-manager-code
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-code
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600
# DATABASE_URL la bien moi truong HE DIEU HANH (khong doc tu file .env).
# Mac dinh he thong dung SQLite tai backend/database/parking.db.
# DATABASE_URL=sqlite:///./parking.db
